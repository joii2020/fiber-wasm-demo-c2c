{
    "name": "fiber-wasm-demo",
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build:fiber-js": "cd ../fiber/fiber-js && pnpm run build",
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "fmt": "biome format --write .",
        "lint": "biome lint ."
    },
    "dependencies": {
        "@ckb-ccc/core": "^1.12.3",
        "@nervosnetwork/fiber-js": "file:../fiber/fiber-js"
    },
    "pnpm": {
        "overrides": {
            "fiber-wasm": "file:../fiber/crates/fiber-wasm",
            "fiber-wasm-db-worker": "file:../fiber/crates/fiber-wasm-db-worker"
        }
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@types/node": "^22.13.8",
        "typescript": "^5.7.3",
        "vite": "^5.4.21"
    }
}
